# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/finance?retryWrites=true&w=majority

# Authentication Secrets
JWT_SECRET=replace_with_a_long_random_jwt_secret_key
OTP_SECRET=replace_with_a_long_random_otp_secret_key

# Frontend URL (For CORS in production on Render)
# E.g. https://your-project.vercel.app (or comma-separated URLs)
CLIENT_URL=http://localhost:5173

# Gmail SMTP for OTP Verification
# Create an App Password from your Google Account: Security > 2-Step Verification > App Passwords
EMAIL=your_email@gmail.com
EMAIL_PASS=your_16_character_app_password
